    // Render ungrouped categories
    ungrouped.forEach((row, i) => {
      const variance = row.actual - row.budget;
      const varianceClass = variance > 0 ? 'over' : 'ok';
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="cat">
          ${row.cat}
          ${row.fixed ? '<span class="fixed-label" style="display: inline-block; background: var(--surface2); border: 1px solid var(--accent); padding: 2px 8px; font-size: 10px; color: var(--accent); letter-spacing: 0.1em; text-transform: uppercase; border-radius: 3px; font-weight: 500; margin-left: 8px; vertical-align: middle; line-height: 1.4;">fixed</span>' : ''}
        </td>
        <td style="text-align:right;">
          <div class="input-cell">
            <span class="currency-sym">${currencySym}</span>
            <input class="budget-input-dark" type="number" value="${row.budget}" data-id="${row.id}" data-currency="${userCurrency}" onchange="onBudgetChange('${row.id}', this, '${userCurrency}')" onblur="onBudgetChange('${row.id}', this, '${userCurrency}')" style="background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 500; width: 80px; text-align: right; padding: 4px 8px; border-radius: 4px; outline: none;">
          </div>
        </td>
        <td style="text-align:right;">
          <div class="input-cell" style="gap: 4px;">
            <button onclick="copyBudgetToActual('${row.id}', '${userCurrency}')" style="background: var(--surface2); border: 1px solid var(--border); color: var(--accent); font-family: 'DM Mono', monospace; font-size: 10px; padding: 4px 6px; cursor: pointer; border-radius: 3px; transition: all 0.15s; line-height: 1;" onmouseover="this.style.borderColor='var(--accent)'; this.style.background='var(--surface)'" onmouseout="this.style.borderColor='var(--border)'; this.style.background='var(--surface2)'" title="Copy budget to actual">→</button>
            <button onclick="clearActual('${row.id}', '${userCurrency}')" style="background: var(--surface2); border: 1px solid var(--border); color: var(--red); font-family: 'DM Mono', monospace; font-size: 10px; padding: 4px 6px; cursor: pointer; border-radius: 3px; transition: all 0.15s; line-height: 1;" onmouseover="this.style.borderColor='var(--red)'; this.style.background='var(--surface)'" onmouseout="this.style.borderColor='var(--border)'; this.style.background='var(--surface2)'" title="Clear actual amount">×</button>
            <span class="currency-sym">${currencySym}</span>
            <input class="budget-input-dark" type="number" value="${row.actual}" data-id="${row.id}" data-currency="${userCurrency}" data-type="actual" onchange="onActualChange('${row.id}', this, '${userCurrency}')" onblur="onActualChange('${row.id}', this, '${userCurrency}')" style="background: var(--surface2); border: 1px solid var(--border); color: var(--text); font-family: 'DM Mono', monospace; font-size: 12px; font-weight: 500; width: 80px; text-align: right; padding: 4px 8px; border-radius: 4px; outline: none;">
          </div>
        </td>
        <td class="budget-val ${varianceClass}" style="text-align:right;">${formatCurrency(Math.abs(variance), userCurrency)}</td>
      `;
      tbody.appendChild(tr);
    });
    
    // Add focus handlers to maintain dark background
    document.querySelectorAll('#zarBody .budget-input-dark').forEach(input => {
      const inputEl = input as HTMLInputElement;
      inputEl.addEventListener('focus', function() {
        this.style.background = 'var(--surface2)';
        this.style.borderColor = 'var(--accent)';
      });
      inputEl.addEventListener('blur', function() {
        this.style.background = 'var(--surface2)';
        this.style.borderColor = 'var(--border)';
      });
    });
  }

  async function onBudgetChange(categoryId: string, input: HTMLInputElement, currency: string) {
    const val = parseFloat(input.value) || 0;
    
    try {
      // Get current actual amount
      const currentBudget = zarData.find(r => r.id === categoryId);
      const currentActual = currentBudget?.actual || 0;
      
      const { data: { user } } = await supabase.auth.getUser();
      await supabase.from('budgets').upsert({
        category_id: categoryId,
        month: currentMonth,
        budget_amount: val,
        actual_amount: currentActual,
        user_id: user?.id
      }, { onConflict: 'category_id,month,user_id' });
      
      // Update in data array
      const index = zarData.findIndex(r => r.id === categoryId);
      if (index !== -1) {
        zarData[index].budget = val;
        zarBudgets[index] = val;
      }
      
      refreshTotals();
      rebuildTable(currency);
    } catch (error) {
      console.error('Error updating budget:', error);
    }
  }

  async function copyBudgetToActual(categoryId: string, currency: string) {
    try {
      const category = zarData.find(r => r.id === categoryId);
      if (!category) return;
      
      const budgetAmount = category.budget || 0;
      
      const { data: { user } } = await supabase.auth.getUser();
      await supabase.from('budgets').upsert({
        category_id: categoryId,
        month: currentMonth,
        budget_amount: budgetAmount,
        actual_amount: budgetAmount,
        user_id: user?.id
      }, { onConflict: 'category_id,month,user_id' });
      
      // Update in data array
      const index = zarData.findIndex(r => r.id === categoryId);
      if (index !== -1) {
        zarData[index].actual = budgetAmount;
        zarActuals[index] = budgetAmount;
      }
      
      refreshTotals();
      rebuildTable(currency);
      updateZarToGbpConversion();
    } catch (error) {
      console.error('Error copying budget to actual:', error);
    }
  }

  async function clearActual(categoryId: string, currency: string) {
    try {
      const category = zarData.find(r => r.id === categoryId);
      if (!category) return;
      
      const budgetAmount = category.budget || 0;
      
      const { data: { user } } = await supabase.auth.getUser();
      await supabase.from('budgets').upsert({
        category_id: categoryId,
        month: currentMonth,
        budget_amount: budgetAmount,
        actual_amount: 0,
        user_id: user?.id
      }, { onConflict: 'category_id,month,user_id' });
      
      // Update in data array
      const index = zarData.findIndex(r => r.id === categoryId);
      if (index !== -1) {
        zarData[index].actual = 0;
        zarActuals[index] = 0;
      }
      
      refreshTotals();
      rebuildTable(currency);
      updateZarToGbpConversion();
    } catch (error) {
      console.error('Error clearing actual:', error);
    }
  }

  async function onActualChange(categoryId: string, input: HTMLInputElement, currency: string) {
    const val = parseFloat(input.value) || 0;
    
    try {
      // Get current budget amount
      const currentBudget = zarData.find(r => r.id === categoryId);
      const currentBudgetAmount = currentBudget?.budget || 0;
      
      const { data: { user } } = await supabase.auth.getUser();
      await supabase.from('budgets').upsert({
        category_id: categoryId,
        month: currentMonth,
        budget_amount: currentBudgetAmount,
        actual_amount: val,
        user_id: user?.id
      }, { onConflict: 'category_id,month,user_id' });
      
      // Update in data array
      const index = zarData.findIndex(r => r.id === categoryId);
      if (index !== -1) {
        zarData[index].actual = val;
        zarActuals[index] = val;
      }
      
      refreshTotals();
      rebuildTable(currency);
      updateZarToGbpConversion();
    } catch (error) {
      console.error('Error updating actual:', error);
    }
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function renderIncomeSources() {
    const container = document.getElementById('incomeSourcesList');
    if (!container) return;
    container.innerHTML = '';

    const sym = getCurrencySymbol(userCurrency);

    incomeSources.forEach(source => {
      const row = document.createElement('div');
      row.style.cssText = 'display: flex; align-items: center; gap: 8px;';
      row.innerHTML = `
        <input type="text" value="${escapeHtml(source.source_name)}"
          style="flex: 1; background: var(--surface2); border: 1px solid var(--border); color: var(--text);
                 font-family: 'DM Mono', monospace; font-size: 12px; padding: 8px 12px; border-radius: 4px;"
          onchange="updateIncomeSourceName('${source.id}', this.value)"
          placeholder="e.g. Salary">
        <div class="input-cell" style="flex-shrink: 0;">
          <span class="currency-sym">${sym}</span>
          <input type="number" value="${source.amount || ''}"
            style="background: var(--surface2); border: 1px solid var(--border); color: var(--text);
                   font-family: 'DM Mono', monospace; font-size: 12px; padding: 8px 12px; border-radius: 4px; width: 120px; text-align: right;"
            placeholder="0"
            onchange="updateIncomeAmount('${source.id}', this.value)"
            onblur="updateIncomeAmount('${source.id}', this.value)">
        </div>
        <button onclick="removeIncomeSource('${source.id}')"
          style="background: transparent; border: 1px solid var(--border); color: var(--red);
                 font-family: 'DM Mono', monospace; font-size: 11px; padding: 6px 10px; cursor: pointer; border-radius: 4px; flex-shrink: 0;"
          onmouseover="this.style.borderColor='var(--red)'"
          onmouseout="this.style.borderColor='var(--border)'">×</button>
      `;
      container.appendChild(row);
    });

    // Update carried over display
    const carriedOverEl = document.getElementById('carriedOverDisplay');
    if (carriedOverEl) {
      carriedOverEl.textContent = carriedOver !== 0
        ? formatCurrency(carriedOver, userCurrency)
        : '—';
    }
  }

  async function addIncomeSource() {
    const name = await showPrompt('Add Income Source', 'e.g. Salary, Freelance', 'Add');
    if (!name) return;

    const { data: { user } } = await supabase.auth.getUser();

    try {
      // Create template row
      await supabase.from('incomes').upsert({
        source_name: name,
        month: '1970-01-01',
        amount: 0,
        currency: userCurrency,
        is_template: true,
        user_id: user?.id
      }, { onConflict: 'source_name,month,user_id' });

      // Create monthly row for current month
      const { data } = await supabase.from('incomes').upsert({
        source_name: name,
        month: currentMonth,
        amount: 0,
        currency: userCurrency,
        is_template: false,
        user_id: user?.id
      }, { onConflict: 'source_name,month,user_id' }).select().single();

      if (data) {
        incomeSources.push({ id: data.id, source_name: name, amount: 0 });
        renderIncomeSources();
        refreshTotals();
      }
    } catch (error: any) {
      showToast('Error adding income source: ' + error.message, 'error');
    }
  }

  async function removeIncomeSource(id: string) {
    const source = incomeSources.find(s => s.id === id);
    if (!source) return;

    const confirmed = await showConfirm(
      'Remove Income Source',
      `Remove "${source.source_name}" from all months? This deletes all monthly entries and the template.`,
      'Remove',
      true
    );
    if (!confirmed) return;

    const { data: { user } } = await supabase.auth.getUser();

    try {
      // Delete all monthly rows for this source
      await supabase.from('incomes')
        .delete()
        .eq('source_name', source.source_name)
        .eq('user_id', user?.id);

      incomeSources = incomeSources.filter(s => s.id !== id);
      renderIncomeSources();
      refreshTotals();
    } catch (error: any) {
      showToast('Error removing income source: ' + error.message, 'error');
    }
  }

  async function updateIncomeAmount(id: string, value: string) {
    const val = parseFloat(value) || 0;
    const source = incomeSources.find(s => s.id === id);
    if (!source) return;

    try {
      await supabase.from('incomes')
        .update({ amount: val })
        .eq('id', id);

      source.amount = val;
      totalIncome = incomeSources.reduce((sum, s) => sum + s.amount, 0);
      refreshTotals();
    } catch (error: any) {
      showToast('Error updating income: ' + error.message, 'error');
    }
  }

  async function updateIncomeSourceName(id: string, newName: string) {
    if (!newName.trim()) return;
    const source = incomeSources.find(s => s.id === id);
    if (!source) return;

    const { data: { user } } = await supabase.auth.getUser();

    try {
      // Update the monthly row name
      await supabase.from('incomes')
        .update({ source_name: newName.trim() })
        .eq('id', id);

      // Update the template row name
      await supabase.from('incomes')
        .update({ source_name: newName.trim() })
        .eq('source_name', source.source_name)
        .eq('is_template', true)
        .eq('user_id', user?.id);

      source.source_name = newName.trim();
    } catch (error: any) {
      showToast('Error updating name: ' + error.message, 'error');
    }
  }

  async function updateBalance(currency: string, type: string, value: string) {
    const val = value !== '' ? parseFloat(value) : null;
    const { data: { user } } = await supabase.auth.getUser();
    
    try {
      // First, try to get existing balance
      const { data: existing } = await supabase
        .from('monthly_balances')
        .select('*')
        .eq('month', currentMonth)
        .eq('currency', userCurrency)
        .maybeSingle();
      
      const updateData = {
        month: currentMonth,
        currency: userCurrency,
        starting_balance: type === 'start' ? val : (existing?.starting_balance ?? null),
        ending_balance: type === 'end' ? val : (existing?.ending_balance ?? null),
        user_id: user?.id
      };
      
      await supabase.from('monthly_balances').upsert(updateData, {
        onConflict: 'month,currency,user_id'
      });

      // When the ending balance is saved, auto-propagate it to the next month's
      // starting balance — but only if the next month doesn't already have one set.
      if (type === 'end' && val !== null) {
        const nextMonthDate = new Date(currentMonth);
        nextMonthDate.setMonth(nextMonthDate.getMonth() + 1);
        const nextMonth = nextMonthDate.toISOString().slice(0, 7) + '-01';

        const { data: nextBalance } = await supabase
          .from('monthly_balances')
          .select('starting_balance, ending_balance')
          .eq('month', nextMonth)
          .eq('user_id', user?.id)
          .maybeSingle();

        if (!nextBalance || nextBalance.starting_balance === null) {
          await supabase.from('monthly_balances').upsert({
            month: nextMonth,
            currency: userCurrency,
            starting_balance: val,
            ending_balance: nextBalance?.ending_balance ?? null,
            user_id: user?.id
          }, { onConflict: 'month,currency,user_id' });
        }
      }
    } catch (error) {
      console.error('Error updating balance:', error);
    }

    refreshTotals();
  }

  function changeMonth(direction: number) {
    const date = new Date(currentMonth);
    date.setMonth(date.getMonth() + direction);
    currentMonth = date.toISOString().slice(0, 7) + '-01';
    updateMonthDisplay();
    loadMonth();
  }

  function updateMonthDisplay() {
    const el = document.getElementById('monthDisplay');
    if (el) {
      const date = new Date(currentMonth);
      el.textContent = date.toLocaleString('default', { month: 'long', year: 'numeric' });
    }
  }

  function toggleGroup(groupName: string) {
    // Toggle the group state
    groupStates[groupName] = !groupStates[groupName];
    // Rebuild the table to reflect the new state
    buildZAR();
  }

  function rebuildTable(currency: string) {
    buildZAR();
  }

  function refreshTotals() {
    const zarBudgetTotal = zarBudgets.reduce((a: number, b: number) => a+b, 0);
    const zarActualTotal = zarActuals.reduce((a: number, b: number) => a+b, 0);
    const zarVariance = zarActualTotal - zarBudgetTotal;

    const calculatedEnding = carriedOver + totalIncome - zarActualTotal;
    const actualEndingInput = document.getElementById('zarEndBalance') as HTMLInputElement | null;
    const actualEnding = parseFloat(actualEndingInput?.value || '0') || 0;
    const reconcVariance = Math.round((calculatedEnding - actualEnding) * 100) / 100;

    // Update totals
    const zarTotalBudgetEl = document.getElementById('zarTotalBudget');
    const zarTotalActualEl = document.getElementById('zarTotalActual');
    const zarTotalVarianceEl = document.getElementById('zarTotalVariance');
    
    if (zarTotalBudgetEl) zarTotalBudgetEl.textContent = formatCurrency(zarBudgetTotal, userCurrency);
    if (zarTotalActualEl) zarTotalActualEl.textContent = formatCurrency(zarActualTotal, userCurrency);
    if (zarTotalVarianceEl) {
      zarTotalVarianceEl.textContent = formatCurrency(Math.abs(zarVariance), userCurrency);
      zarTotalVarianceEl.className = 'budget-val ' + (zarVariance > 0 ? 'over' : 'ok');
    }

    // ── Reconciliation status bar ─────────────────────────────────────────
    const reconcBar = document.getElementById('reconcBar');
    if (reconcBar) {
      if (reconcVariance === 0) {
        reconcBar.className = 'recon-bar recon-ok';
        reconcBar.innerHTML = `<span class="recon-icon">&#10003;</span> All transactions accounted for`;
      } else {
        const sym = getCurrencySymbol(userCurrency);
        reconcBar.className = 'recon-bar recon-err';
        reconcBar.innerHTML = `<span class="recon-icon">&#10005;</span> ${formatCurrency(Math.abs(reconcVariance), userCurrency)} mismatch — you may be missing a transaction`;
      }
      reconcBar.style.display = 'flex';
    }

    // ── Financial summary block ───────────────────────────────────────────
    const budgetRemaining = zarBudgetTotal - zarActualTotal;
    // cashRemaining = money you actually have left (starting balance + income – spend)
    const cashRemaining   = carriedOver + totalIncome - zarActualTotal;

    const overspent = cashRemaining < 0;

    const finSpentEl               = document.getElementById('finSpent');
    const finBudgetEl              = document.getElementById('finBudget');
    const finBudgetRemainingEl     = document.getElementById('finBudgetRemaining');
    const finBudgetRemainingLabel  = document.getElementById('finBudgetRemainingLabel');
    const finCashRemainingEl       = document.getElementById('finCashRemaining');
    const finStatusBanner          = document.getElementById('finStatusBanner');
    const finPrimaryHeadline       = document.getElementById('finPrimaryHeadline');
    const finPrimaryDetail         = document.getElementById('finPrimaryDetail');
    const finPrimarySupport        = document.getElementById('finPrimarySupport');

    if (finPrimaryHeadline && finPrimaryDetail && finPrimarySupport && finStatusBanner) {
      if (overspent) {
        finStatusBanner.className = 'fin-status-banner fin-status-overspent';
        finPrimaryHeadline.textContent = 'You ran out of money this month';
        finPrimaryDetail.style.display = 'block';
        finPrimaryDetail.textContent =
          `You overspent your available cash by ${formatCurrency(Math.abs(cashRemaining), userCurrency)}`;
        if (budgetRemaining > 0 && cashRemaining < 0) {
          finPrimarySupport.hidden = false;
          finPrimarySupport.textContent =
            'You spent less than planned, but your starting balance was not enough to cover your spending.';
        } else {
          finPrimarySupport.hidden = true;
          finPrimarySupport.textContent = '';
        }
      } else {
        finStatusBanner.className = 'fin-status-banner fin-status-ok';
        finPrimaryHeadline.textContent = 'You stayed within your available cash';
        finPrimaryDetail.style.display = 'none';
        finPrimaryDetail.textContent = '';
        finPrimarySupport.hidden = true;
        finPrimarySupport.textContent = '';
      }
    }

    if (finSpentEl)  finSpentEl.textContent = formatCurrency(zarActualTotal, userCurrency);
    if (finBudgetEl) finBudgetEl.textContent = formatCurrency(zarBudgetTotal, userCurrency);

    if (finBudgetRemainingEl) {
      finBudgetRemainingEl.textContent = formatCurrency(Math.abs(budgetRemaining), userCurrency);
      finBudgetRemainingEl.className =
        'fin-val fin-val-planning ' +
        (budgetRemaining < 0 ? 'fin-over' : budgetRemaining === 0 ? '' : 'fin-ok');
    }
    if (finBudgetRemainingLabel) {
      finBudgetRemainingLabel.textContent =
        budgetRemaining < 0 ? 'Beyond planned spend' : 'Planned underspend';
    }

    if (finCashRemainingEl) {
      finCashRemainingEl.textContent = formatCurrency(Math.abs(cashRemaining), userCurrency);
      finCashRemainingEl.className =
        'fin-val fin-val-secondary ' +
        (cashRemaining < 0 ? 'fin-over' : cashRemaining === 0 ? '' : 'fin-ok');
    }

    const finSummary = document.getElementById('financialSummary');
    if (finSummary) finSummary.style.display = 'flex';

    // ── Monthly category insights ─────────────────────────────────────────
    renderMonthlyInsights(cashRemaining, budgetRemaining);

    // Update ZAR to GBP conversion
    updateZarToGbpConversion();
  }



  async function updateExchangeRate() {
    if (!userSettings.show_currency_conversion) {
      return;
    }
    
    try {
      const baseCurrency = userSettings.base_currency || 'ZAR';
      const conversionCurrency = userSettings.conversion_currency || 'GBP';
      
      // Using exchangerate-api.com free tier (no API key needed for basic usage)
      const response = await fetch(`https://api.exchangerate-api.com/v4/latest/${baseCurrency}`);
      const data = await response.json();
      
      if (data && data.rates && data.rates[conversionCurrency]) {
        exchangeRate = parseFloat(data.rates[conversionCurrency]);
        const rateEl = document.getElementById('exchangeRate');
        const baseSymbol = getCurrencySymbol(baseCurrency as CurrencyCode);
        const convSymbol = getCurrencySymbol(conversionCurrency as CurrencyCode);
        
        if (rateEl) {
          rateEl.textContent = `1 ${baseCurrency} = ${convSymbol}${exchangeRate.toFixed(4)}`;
          rateEl.style.color = 'var(--accent)';
        }
        updateZarToGbpConversion();
      } else {
        throw new Error('Exchange rate data not available');
      }
    } catch (error) {
      console.error('Error fetching exchange rate:', error);
      const rateEl = document.getElementById('exchangeRate');
      if (rateEl) {
        rateEl.textContent = 'Error loading rate';
        rateEl.style.color = 'var(--red)';
      }
      // Fallback to a default rate if API fails
      exchangeRate = 0.042;
      updateZarToGbpConversion();
    }
  }

  function updateZarToGbpConversion() {
    if (!userSettings.show_currency_conversion) {
      return;
    }
    
    const baseCurrency = (userSettings.base_currency || 'ZAR') as CurrencyCode;
    const conversionCurrency = (userSettings.conversion_currency || 'GBP') as CurrencyCode;
    const baseSymbol = getCurrencySymbol(baseCurrency);
    const convSymbol = getCurrencySymbol(conversionCurrency);
    
    const zarBudgetTotal = zarBudgets.reduce((a: number, b: number) => a + b, 0);
    const zarActualTotal = zarActuals.reduce((a: number, b: number) => a + b, 0);
    const zarNetTotal = totalIncome + carriedOver - zarActualTotal;
    
    // Budget conversion
    const zarBudgetEl = document.getElementById('zarBudgetForConversion');
    const zarBudgetGbpEl = document.getElementById('zarBudgetConvertedGbp');
    const budgetBaseAmountEl = document.getElementById('budgetBaseAmount');
    const budgetConvAmountEl = document.getElementById('budgetConvAmount');
    
    if (zarBudgetEl) {
      zarBudgetEl.textContent = zarBudgetTotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    if (budgetBaseAmountEl) {
      budgetBaseAmountEl.innerHTML = `${baseSymbol}<span id="zarBudgetForConversion">${zarBudgetTotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>`;
    }
    if (zarBudgetGbpEl && exchangeRate > 0) {
      const converted = zarBudgetTotal * exchangeRate;
      zarBudgetGbpEl.textContent = converted.toFixed(2);
    }
    if (budgetConvAmountEl && exchangeRate > 0) {
      const converted = zarBudgetTotal * exchangeRate;
      budgetConvAmountEl.innerHTML = `${convSymbol}<span id="zarBudgetConvertedGbp">${converted.toFixed(2)}</span>`;
    }
    
    // Actual conversion
    const zarActualEl = document.getElementById('zarActualForConversion');
    const zarActualGbpEl = document.getElementById('zarActualConvertedGbp');
    const actualBaseAmountEl = document.getElementById('actualBaseAmount');
    const actualConvAmountEl = document.getElementById('actualConvAmount');
    
    if (zarActualEl) {
      zarActualEl.textContent = zarActualTotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    if (actualBaseAmountEl) {
      actualBaseAmountEl.innerHTML = `${baseSymbol}<span id="zarActualForConversion">${zarActualTotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>`;
    }
    if (zarActualGbpEl && exchangeRate > 0) {
      const converted = zarActualTotal * exchangeRate;
      zarActualGbpEl.textContent = converted.toFixed(2);
    }
    if (actualConvAmountEl && exchangeRate > 0) {
      const converted = zarActualTotal * exchangeRate;
      actualConvAmountEl.innerHTML = `${convSymbol}<span id="zarActualConvertedGbp">${converted.toFixed(2)}</span>`;
    }
    
    // Net conversion
    const zarNetEl = document.getElementById('zarNetForConversion');
    const zarNetGbpEl = document.getElementById('zarNetConvertedGbp');
    const netBaseAmountEl = document.getElementById('netBaseAmount');
    const netConvAmountEl = document.getElementById('netConvAmount');
    
    if (zarNetEl) {
      zarNetEl.textContent = zarNetTotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    if (netBaseAmountEl) {
      netBaseAmountEl.innerHTML = `${baseSymbol}<span id="zarNetForConversion">${zarNetTotal.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</span>`;
    }
    if (zarNetGbpEl && exchangeRate > 0) {
      const converted = zarNetTotal * exchangeRate;
      zarNetGbpEl.textContent = converted.toFixed(2);
      zarNetGbpEl.style.color = zarNetTotal >= 0 ? 'var(--accent)' : 'var(--red)';
    }
    if (netConvAmountEl && exchangeRate > 0) {
      const converted = zarNetTotal * exchangeRate;
      netConvAmountEl.innerHTML = `${convSymbol}<span id="zarNetConvertedGbp">${converted.toFixed(2)}</span>`;
      netConvAmountEl.style.color = zarNetTotal >= 0 ? 'var(--accent)' : 'var(--red)';
    }
  }

  // Make functions available globally
  window.onBudgetChange = onBudgetChange;
  window.onActualChange = onActualChange;
  window.copyBudgetToActual = copyBudgetToActual;
  window.clearActual = clearActual;
  window.updateBalance = updateBalance;
  window.addIncomeSource = addIncomeSource;
  window.removeIncomeSource = removeIncomeSource;
  window.updateIncomeAmount = updateIncomeAmount;
  window.updateIncomeSourceName = updateIncomeSourceName;
  window.updateExchangeRate = updateExchangeRate;
  window.toggleGroup = toggleGroup;
  window.loadMonth = loadMonth;
  window.handleSignOut = handleSignOut;
  window.changeMonth = changeMonth;
  window.toggleTheme = toggleTheme;
  window.toggleImportedTx = toggleImportedTx;
  window.onImportedTxCategoryChange = onImportedTxCategoryChange;

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

