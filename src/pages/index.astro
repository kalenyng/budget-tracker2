---
// Yearly overview page
import DesktopLayout from '../layouts/DesktopLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import StepControl from '../components/StepControl.astro';
import { supabase } from '../lib/supabase';

// Prevent pre-rendering so middleware can redirect
export const prerender = false;

const pathname = Astro.url.pathname;
---

<DesktopLayout title="Yearly Overview - Budget Tracker" pathname={pathname}>
  <div slot="toolbar-start">
    <StepControl variant="fy" />
  </div>
<div class="page">

  <PageTitle
    label="Personal finance tracker"
    titleBefore="Yearly"
    titleAccent=" Overview"
    subtitle="Financial year: April to March"
  />

  <!-- Top status (FY pace) -->
  <div id="statusBanner" class="dash-status-bar" style="display: none;">
    <span id="statusPip" class="dash-status-pip" aria-hidden="true"></span>
    <span id="statusLabel" class="dash-status-title">—</span>
    <span id="statusDetail" class="dash-status-meta"></span>
  </div>

  <!-- This month: three KPIs -->
  <div class="dashboard-kpi-row" id="yearSummary">
    <div class="dash-card dash-kpi-card">
      <div class="dash-kpi-label">Left this month</div>
      <div class="dash-kpi-value" id="kpiLeftVal">—</div>
      <div class="dash-kpi-hint" id="kpiLeftHint"></div>
    </div>
    <div class="dash-card dash-kpi-card">
      <div class="dash-kpi-label">Spent</div>
      <div class="dash-kpi-value" id="kpiSpentVal">—</div>
      <div class="dash-kpi-hint" id="kpiSpentHint"></div>
    </div>
    <div class="dash-card dash-kpi-card">
      <div class="dash-kpi-label">Monthly budget</div>
      <div class="dash-kpi-value" id="kpiBudgetVal">—</div>
      <div class="dash-kpi-hint" id="kpiBudgetHint">Sum of category budgets</div>
    </div>
  </div>

  <div class="dashboard-split" id="dashboardSplit">
    <div class="dash-card dash-panel">
      <div class="dash-panel-head">
        <h2 class="dash-panel-title">Recent transactions</h2>
        <a class="dash-panel-link" href="/transactions">View all</a>
      </div>
      <div class="dash-table-wrap">
        <table class="dash-tx-table" id="recentTxTable">
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Description</th>
              <th scope="col" class="num">Amount</th>
            </tr>
          </thead>
          <tbody id="recentTxBody">
            <tr><td colspan="3" class="dash-empty">Loading…</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="dash-right-stack">
      <div class="dash-card dash-panel">
        <div class="dash-panel-head">
          <h2 class="dash-panel-title">Daily spend</h2>
          <span class="dash-panel-meta" id="dailySpendMonthLabel"></span>
        </div>
        <div class="dash-bar-chart" id="dailySpendChart" aria-label="Daily spending for this month"></div>
        <div class="dash-bar-labels" id="dailySpendLabels"></div>
      </div>

      <div class="dash-card dash-panel">
        <div class="dash-panel-head">
          <h2 class="dash-panel-title">Heads-up alerts</h2>
        </div>
        <section id="insightsPanel" class="dash-insights" style="display: none;" aria-label="Spending insights">
          <div class="insights-list" id="insightsList"></div>
        </section>
        <p class="dash-empty dash-insights-empty" id="insightsEmpty">Nothing flagged for now.</p>
      </div>
    </div>
  </div>

  <!-- Currency Conversion Summary -->
  <div class="app-card" id="zarToGbpSummary" style="margin-bottom: 48px; display: none;">
    <div class="label" id="conversionLabel">Currency Conversion</div>
    <div class="nested-panel" style="margin-top: var(--space-5);">
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 24px;">
      <div>
        <label style="color: var(--text-dim); font-size: 10px; display: block; margin-bottom: 4px;">Exchange Rate</label>
        <div style="font-family: 'DM Mono', monospace; font-size: 16px; font-weight: 500; color: var(--accent);">
          <span id="exchangeRate">Loading...</span>
          <button onclick="updateExchangeRate()" style="background: var(--surface2); border: 1px solid var(--border); color: var(--text-dim); font-family: 'DM Mono', monospace; font-size: 10px; padding: 4px 8px; margin-left: 8px; cursor: pointer; border-radius: 3px; transition: all 0.15s;" onmouseover="this.style.borderColor='var(--accent)'; this.style.color='var(--accent)'" onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--text-dim)'">Refresh</button>
        </div>
      </div>
      <div>
        <label style="color: var(--text-dim); font-size: 10px; display: block; margin-bottom: 4px;">Budget Total</label>
        <div style="font-family: 'DM Mono', monospace; font-size: 18px; font-weight: 500; color: var(--text);"><span id="yearBudgetZar">0</span></div>
        <div style="font-family: 'DM Mono', monospace; font-size: 14px; font-weight: 500; color: var(--accent); margin-top: 4px;"><span id="yearBudgetGbp">0</span></div>
      </div>
      <div>
        <label style="color: var(--text-dim); font-size: 10px; display: block; margin-bottom: 4px;">Actual Total</label>
        <div style="font-family: 'DM Mono', monospace; font-size: 18px; font-weight: 500; color: var(--text);"><span id="yearActualZar">0</span></div>
        <div style="font-family: 'DM Mono', monospace; font-size: 14px; font-weight: 500; color: var(--accent); margin-top: 4px;"><span id="yearActualGbp">0</span></div>
      </div>
      <div>
        <label style="color: var(--text-dim); font-size: 10px; display: block; margin-bottom: 4px;">Net Total</label>
        <div style="font-family: 'DM Mono', monospace; font-size: 18px; font-weight: 500; color: var(--text);"><span id="yearNetZar">0</span></div>
        <div style="font-family: 'DM Mono', monospace; font-size: 14px; font-weight: 500; color: var(--accent); margin-top: 4px;"><span id="yearNetGbp">0</span></div>
      </div>
      </div>
    </div>
  </div>

  <!-- Category Breakdown -->
  <div id="categoryBreakdown">
    <div class="section-title envelope-section-title">Annual envelopes</div>
    <div id="categoriesContainer" class="envelope-grid"></div>
  </div>

  <footer>
    Budget Tracker · FY Overview
  </footer>

</div>

<div id="catModal" style="display:none; position:fixed; inset:0; z-index:9997; background: rgba(0,0,0,0.6); backdrop-filter: blur(2px);" onclick="closeCatModal(event)">
  <div id="catModalInner" style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); background:var(--surface); border:1px solid var(--border); border-radius:4px; padding:32px; min-width:480px; max-width:640px; width:90%;">
    <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:24px;">
      <h2 id="catModalName" style="font-family: var(--font-display), serif; font-size:24px; font-weight:400; font-style:italic; color:var(--text);"></h2>
      <button onclick="closeCatModal()" style="background:transparent; border:none; color:var(--text-dim); font-family:'DM Mono',monospace; font-size:18px; cursor:pointer; padding:0 4px;">×</button>
    </div>
    <table id="catModalTable" style="width:100%; border-collapse:collapse;"></table>
    <div id="catModalTotals" style="margin-top:16px; padding-top:16px; border-top:1px solid var(--border); display:grid; grid-template-columns:1fr 1fr 1fr; gap:16px;"></div>
  </div>
</div>

<button type="button" class="theme-toggle" onclick="toggleTheme()" id="themeToggle" aria-label="Toggle color theme">Light</button>

<script>
  import { supabase } from '../lib/supabase';
  import { getCurrentUser, onAuthStateChange, signOut } from '../lib/auth';
  import { formatCurrency, getCurrencySymbol, type CurrencyCode } from '../lib/currency';
  import { getYearlyMetrics, getMonthsElapsed, type YearlyMetrics } from '../lib/yearlyMetrics';
  import { getInsights } from '../lib/insights';
  import { showConfirm } from '../lib/dialogs';
  import type { User } from '@supabase/supabase-js';

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    const btn = document.getElementById('themeToggle');
    // Label = theme you switch *to* when clicked (matches month, transactions, settings).
    if (btn) btn.textContent = theme === 'light' ? 'Dark' : 'Light';
  }

  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    const next = current === 'light' ? 'dark' : 'light';
    localStorage.setItem('theme', next);
    applyTheme(next);
  }

  // Apply saved theme immediately on load
  const savedTheme = localStorage.getItem('theme') || 'dark';
  applyTheme(savedTheme);


  // Check authentication on page load
  async function checkAuth() {
    const user = await getCurrentUser();
    if (!user) {
      window.location.href = '/auth';
      return false;
    }
    updateCurrentUserEmail(user);
    return true;
  }

  function updateCurrentUserEmail(user: User | null) {
    const emailEl = document.getElementById('currentUserEmail');
    if (!emailEl) return;
    emailEl.textContent = user?.email || 'Signed in';
    emailEl.title = user?.email || 'Signed in user';
  }

  // Handle sign out
  async function handleSignOut() {
    if (await showConfirm('Sign Out', 'Are you sure you want to sign out?', 'Sign Out')) {
      await signOut();
      window.location.href = '/auth';
    }
  }

  // Type definitions
  interface MonthlyData {
    month: string;
    monthName: string;
    income: number;
    budget: number;
    actual: number;
    net: number;
    order: number; // Financial year order: April=0, May=1, ..., March=11
  }

  interface CategoryData {
    id: string;
    name: string;
    annualBudget: number;
    annualActual: number;
    sortOrder?: number;
    type: 'fixed' | 'variable';
  }

  // Window interface extension
  declare global {
    interface Window {
      loadYear: () => Promise<void>;
      updateExchangeRate: () => Promise<void>;
      changeFY: (direction: number) => void;
      handleSignOut: () => Promise<void>;
      toggleTheme: () => void;
      openCatModal: (categoryId: string) => void;
      closeCatModal: (event?: MouseEvent) => void;
    }
  }

  type CategoryMonthActuals = Record<string, Record<string, number> >;

  // Default to current financial year start
  // If current month is Jan/Feb/Mar, financial year started last year
  const now = new Date();
  let currentYear = now.getMonth() < 3 ? now.getFullYear() - 1 : now.getFullYear();
  let monthlyData: MonthlyData[] = [];
  let categoryData: CategoryData[] = [];
  let categoryMonthlyActuals: CategoryMonthActuals = {};
  let exchangeRate = 0;
  let yearIncome = 0;
  let yearBudget = 0;
  let yearActual = 0;
  let yearNet = 0;
  let monthsElapsed = 0;
  let userCurrency: CurrencyCode = 'ZAR'; // User's preferred currency
  let showCurrencyConversion = false;
  let conversionCurrency: CurrencyCode = 'GBP';

  function updateYearLabel() {
    const labelEl = document.getElementById('yearLabel');
    if (labelEl) labelEl.textContent = `FY ${currentYear}/${String(currentYear + 1).slice(2)}`;
  }

  function changeFY(direction: number) {
    currentYear += direction;
    updateYearLabel();
    loadYear();
  }

  // Load user currency preference
  async function loadUserCurrency() {
    try {
      const user = await getCurrentUser();
      if (!user) return;

      const { data: settingsRows } = await supabase
        .from('user_settings')
        .select('key, value, preferred_currency')
        .eq('user_id', user.id);

      const settingsMap = Object.fromEntries((settingsRows || []).map(s => [s.key, s.value]));
      userCurrency = (settingsMap['preferred_currency'] as CurrencyCode) || 'ZAR';
      showCurrencyConversion = settingsMap['show_currency_conversion'] === 'true';
      conversionCurrency = (settingsMap['conversion_currency'] as CurrencyCode) || 'GBP';

      // Update conversion section visibility
      const conversionSection = document.getElementById('zarToGbpSummary');
      if (conversionSection) {
        conversionSection.style.display = showCurrencyConversion ? 'block' : 'none';
      }

      const conversionLabel = document.getElementById('conversionLabel');
      if (conversionLabel && showCurrencyConversion) {
        conversionLabel.textContent = `${userCurrency} to ${conversionCurrency} Conversion`;
      }
    } catch (error) {
      console.error('Error loading user currency:', error);
    }
  }

  // Initialize
  async function init() {
    try {
      onAuthStateChange((_event, session) => {
        updateCurrentUserEmail(session?.user ?? null);
        if (!session?.user) {
          window.location.href = '/auth';
        }
      });

      // Check authentication first
      const isAuthenticated = await checkAuth();
      if (!isAuthenticated) {
        return;
      }
      
      // Load user currency preference
      await loadUserCurrency();
      
      // Test connection
      const { data: testData, error: testError } = await supabase
        .from('categories')
        .select('id, name')
        .limit(1);
      
      if (testError) {
        console.error('Connection failed:', testError.message);
        return;
      }
      
      updateYearLabel();
      await loadYear();
    } catch (error) {
      console.error('Initialization error:', error);
    }
  }

  function restoreDashboardKpiRow() {
    const yearSummary = document.getElementById('yearSummary');
    if (!yearSummary) return;
    yearSummary.innerHTML = `
    <div class="dash-card dash-kpi-card">
      <div class="dash-kpi-label">Left this month</div>
      <div class="dash-kpi-value" id="kpiLeftVal">—</div>
      <div class="dash-kpi-hint" id="kpiLeftHint"></div>
    </div>
    <div class="dash-card dash-kpi-card">
      <div class="dash-kpi-label">Spent</div>
      <div class="dash-kpi-value" id="kpiSpentVal">—</div>
      <div class="dash-kpi-hint" id="kpiSpentHint"></div>
    </div>
    <div class="dash-card dash-kpi-card">
      <div class="dash-kpi-label">Monthly budget</div>
      <div class="dash-kpi-value" id="kpiBudgetVal">—</div>
      <div class="dash-kpi-hint" id="kpiBudgetHint">Sum of category budgets</div>
    </div>`;
  }

  function showSkeletons() {
    const statusBanner = document.getElementById('statusBanner');
    if (statusBanner) statusBanner.style.display = 'none';

    const yearSummary = document.getElementById('yearSummary');
    if (yearSummary) {
      yearSummary.innerHTML = `
        <div class="dash-card dash-kpi-card"><div class="skeleton skeleton-block" style="width: 50%;"></div><div class="skeleton dash-kpi-skel"></div></div>
        <div class="dash-card dash-kpi-card"><div class="skeleton skeleton-block" style="width: 40%;"></div><div class="skeleton dash-kpi-skel"></div></div>
        <div class="dash-card dash-kpi-card"><div class="skeleton skeleton-block" style="width: 45%;"></div><div class="skeleton dash-kpi-skel"></div></div>
      `;
    }

    const tbody = document.getElementById('recentTxBody');
    if (tbody) {
      tbody.innerHTML = Array(6).fill(`
        <tr><td class="skeleton-td"><div class="skeleton" style="height:12px;width:72px;"></div></td>
        <td class="skeleton-td"><div class="skeleton" style="height:12px;width:90%;"></div></td>
        <td class="skeleton-td num"><div class="skeleton" style="height:12px;width:64px;margin-left:auto;"></div></td></tr>
      `).join('');
    }

    const chart = document.getElementById('dailySpendChart');
    if (chart) {
      chart.innerHTML = Array(16).fill('<div class="dash-bar dash-bar-skeleton"></div>').join('');
    }
    const labels = document.getElementById('dailySpendLabels');
    if (labels) labels.innerHTML = '';

    const insightsPanel = document.getElementById('insightsPanel');
    const insightsEmpty = document.getElementById('insightsEmpty');
    if (insightsPanel) { insightsPanel.style.display = 'none'; insightsPanel.innerHTML = '<div class="insights-list" id="insightsList"></div>'; }
    if (insightsEmpty) insightsEmpty.style.display = 'none';

    const categoriesContainer = document.getElementById('categoriesContainer');
    if (categoriesContainer) {
      categoriesContainer.innerHTML = Array(6).fill(`
        <div class="envelope-card envelope-card--skeleton" style="pointer-events: none;">
          <div class="envelope-skel-title"></div>
          <div class="envelope-skel-row"></div>
          <div class="envelope-skel-row"></div>
          <div class="envelope-skel-row"></div>
          <div class="envelope-skel-bar"></div>
        </div>
      `).join('');
    }
  }

  function updateStatusBanner(metrics: YearlyMetrics): void {
    const banner   = document.getElementById('statusBanner');
    const pipEl    = document.getElementById('statusPip');
    const labelEl  = document.getElementById('statusLabel');
    const detailEl = document.getElementById('statusDetail');
    if (!banner || !pipEl || !labelEl || !detailEl) return;

    pipEl.className = 'dash-status-pip';

    if (!metrics.hasData) {
      banner.style.display = 'flex';
      banner.className = 'dash-status-bar dash-status-bar--neutral';
      pipEl.classList.add('dash-status-pip--muted');
      labelEl.textContent = 'No data yet';
      detailEl.textContent = 'Add transactions to see your yearly pace';
      return;
    }

    banner.style.display = 'flex';
    banner.className = 'dash-status-bar';

    switch (metrics.status) {
      case 'on-track':
        banner.classList.add('dash-status-bar--ok');
        pipEl.classList.add('dash-status-pip--ok');
        labelEl.textContent = 'On track';
        detailEl.textContent = metrics.spendDiff < 0
          ? `${formatCurrency(Math.abs(metrics.spendDiff), userCurrency)} under expected spend (FY)`
          : `Spending on pace for the financial year`;
        break;
      case 'slightly-over':
        banner.classList.add('dash-status-bar--warn');
        pipEl.classList.add('dash-status-pip--warn');
        labelEl.textContent = 'Slightly over';
        detailEl.textContent = `${formatCurrency(metrics.spendDiff, userCurrency)} over expected (FY)`;
        break;
      case 'overspending':
        banner.classList.add('dash-status-bar--bad');
        pipEl.classList.add('dash-status-pip--bad');
        labelEl.textContent = 'Overspending';
        detailEl.textContent = `${formatCurrency(metrics.spendDiff, userCurrency)} over expected (FY)`;
        break;
      default:
        banner.style.display = 'none';
    }
  }

  function updateMonthlyDashboard(
    monthlyBudgetTotal: number,
    monthlySpent: number,
    transactions: { date: string | null; description: string | null; amount: number; category_id: string | null }[],
    monthLabel: string,
  ): void {
    restoreDashboardKpiRow();

    const left = monthlyBudgetTotal - monthlySpent;
    const kpiLeft = document.getElementById('kpiLeftVal');
    const kpiSpent = document.getElementById('kpiSpentVal');
    const kpiBudget = document.getElementById('kpiBudgetVal');
    const hintLeft = document.getElementById('kpiLeftHint');
    const hintSpent = document.getElementById('kpiSpentHint');

    if (kpiBudget) {
      kpiBudget.textContent = monthlyBudgetTotal > 0 ? formatCurrency(monthlyBudgetTotal, userCurrency) : '—';
    }
    if (kpiSpent) {
      kpiSpent.textContent = formatCurrency(monthlySpent, userCurrency);
      kpiSpent.className = 'dash-kpi-value' + (monthlySpent > monthlyBudgetTotal && monthlyBudgetTotal > 0 ? ' dash-kpi-value--warn' : '');
    }
    if (kpiLeft) {
      if (monthlyBudgetTotal <= 0) {
        kpiLeft.textContent = '—';
        kpiLeft.className = 'dash-kpi-value';
      } else {
        kpiLeft.textContent = formatCurrency(Math.abs(left), userCurrency);
        kpiLeft.className = 'dash-kpi-value' + (left < 0 ? ' dash-kpi-value--warn' : ' dash-kpi-value--ok');
      }
    }
    if (hintLeft) {
      hintLeft.textContent = monthlyBudgetTotal > 0
        ? (left >= 0 ? 'Remaining in calendar month' : 'Over monthly budget')
        : 'Set category budgets in Settings';
    }
    if (hintSpent) {
      hintSpent.textContent = monthLabel;
    }

    const monthLbl = document.getElementById('dailySpendMonthLabel');
    if (monthLbl) monthLbl.textContent = monthLabel;

    const tbody = document.getElementById('recentTxBody');
    if (tbody) {
      const rows = transactions.slice(0, 12);
      if (rows.length === 0) {
        tbody.innerHTML = '<tr><td colspan="3" class="dash-empty">No transactions imported this month.</td></tr>';
      } else {
        tbody.innerHTML = rows.map(tx => {
          const desc = (tx.description || '—').trim() || '—';
          const dt = tx.date || '—';
          const amt = tx.amount;
          const neg = amt < 0;
          const amtStr = formatCurrency(Math.abs(amt), userCurrency);
          const cls = neg ? 'dash-amt-expense' : 'dash-amt-income';
          const sign = neg ? '-' : '';
          return `<tr>
            <td class="dash-tx-date">${escapeHtmlIndex(dt)}</td>
            <td class="dash-tx-desc" title="${escapeAttrIndex(desc)}">${escapeHtmlIndex(desc.length > 48 ? desc.slice(0, 47) + '…' : desc)}</td>
            <td class="num ${cls}"><span class="dash-amt">${sign}${escapeHtmlIndex(amtStr)}</span></td>
          </tr>`;
        }).join('');
      }
    }

    const now = new Date();
    const y = now.getFullYear();
    const m = now.getMonth();
    const daysInMonth = new Date(y, m + 1, 0).getDate();
    const spendByDay: number[] = Array(daysInMonth + 1).fill(0);
    for (const tx of transactions) {
      if (!tx.date || tx.amount >= 0) continue;
      const parts = tx.date.slice(0, 10).split('-');
      const d = parseInt(parts[2] || '0', 10);
      if (d >= 1 && d <= daysInMonth) spendByDay[d] += -tx.amount;
    }
    const maxDay = Math.max(...spendByDay, 1);
    const chartEl = document.getElementById('dailySpendChart');
    if (chartEl) {
      chartEl.innerHTML = Array.from({ length: daysInMonth }, (_, i) => {
        const day = i + 1;
        const v = spendByDay[day] || 0;
        const pct = maxDay > 0 ? Math.round((v / maxDay) * 100) : 0;
        const title = `${day}: ${formatCurrency(v, userCurrency)}`;
        return `<div class="dash-bar-cell" title="${escapeAttrIndex(title)}"><div class="dash-bar" style="height:${pct}%;"></div></div>`;
      }).join('');
    }
    const labelsEl = document.getElementById('dailySpendLabels');
    if (labelsEl) {
      const labelParts: string[] = [];
      for (let d = 1; d <= daysInMonth; d += 1) {
        if (d === 1 || d === daysInMonth || d % 7 === 0) labelParts.push(`<span>${d}</span>`);
        else labelParts.push('<span></span>');
      }
      labelsEl.innerHTML = labelParts.join('');
    }
  }

  function escapeHtmlIndex(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function escapeAttrIndex(text: string): string {
    return text.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
  }

  function updateYearlyDashboard(): void {
    const metrics = getYearlyMetrics({ totalBudget: yearBudget, actualSpend: yearActual, monthsElapsed });
    updateStatusBanner(metrics);
  }

  // ── Insights panel ───────────────────────────────────────────────────────

  function buildInsightsPanel(): void {
    const panel = document.getElementById('insightsPanel');
    const emptyEl = document.getElementById('insightsEmpty');
    if (!panel) return;

    let list = document.getElementById('insightsList');
    if (!list) {
      panel.innerHTML = '<div class="insights-list" id="insightsList"></div>';
      list = document.getElementById('insightsList');
    }
    if (!list) return;

    const burnRate = monthsElapsed > 0 ? yearActual / monthsElapsed : 0;
    const projectedTotal = burnRate * 12;
    const yearProgress = monthsElapsed / 12;
    const expectedSpend = yearBudget * yearProgress;

    const insights = getInsights({
      totalBudget: yearBudget,
      actualSpend: yearActual,
      expectedSpend,
      projectedTotal,
      yearProgress,
      categories: categoryData.map(c => ({
        name: c.name,
        budget: c.annualBudget,
        actual: c.annualActual,
        type: c.type,
      })),
      format: (n: number) => formatCurrency(n, userCurrency),
    });

    if (insights.length === 0) {
      panel.style.display = 'none';
      if (emptyEl) emptyEl.style.display = 'block';
      list.innerHTML = '';
      return;
    }

    if (emptyEl) emptyEl.style.display = 'none';
    panel.style.display = 'block';
    list.innerHTML = insights.map(ins => `
          <div class="insight-row insight-${ins.type}">
            <span class="insight-dot insight-dot-${ins.type}" aria-hidden="true"></span>
            <span class="insight-text">
              <span class="insight-head">${ins.title}</span>
              <span class="insight-detail">${ins.message}</span>
              ${ins.category ? `<span class="insight-tag">${ins.category}</span>` : ''}
            </span>
          </div>
        `).join('');
  }

  async function loadYear() {
    showSkeletons();
    
    try {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return;

      const calNow = new Date();
      const curMonthStart = `${calNow.getFullYear()}-${String(calNow.getMonth() + 1).padStart(2, '0')}-01`;
      
      // Financial year: April (month 3) of currentYear to March (month 2) of currentYear+1
      // Build months array: April, May, ..., December, January, February, March
      const months: string[] = [];
      // First 9 months: April (3) through December (11) of currentYear
      for (let i = 0; i < 9; i++) {
        const monthIndex = 3 + i; // April = month index 3
        // Use UTC to avoid timezone issues
        const monthStr = `${currentYear}-${String(monthIndex + 1).padStart(2, '0')}-01`;
        months.push(monthStr);
      }
      // Last 3 months: January (0), February (1), March (2) of currentYear+1
      for (let i = 0; i < 3; i++) {
        const monthIndex = i; // January = 0, February = 1, March = 2
        // Use UTC to avoid timezone issues
        const monthStr = `${currentYear + 1}-${String(monthIndex + 1).padStart(2, '0')}-01`;
        months.push(monthStr);
      }
      
      const [
        { data: incomes },
        { data: allCategories },
        { data: budgets, error: budgetError },
        { data: monthBudgetRows },
        { data: monthTxRows },
      ] = await Promise.all([
        supabase
          .from('incomes')
          .select('month, amount')
          .in('month', months)
          .eq('is_template', false),
        supabase
          .from('categories')
          .select('id, name, monthly_amount, sort_order, type')
          .order('sort_order', { ascending: true, nullsFirst: false })
          .order('name', { ascending: true }),
        supabase
          .from('budgets')
          .select('month, category_id, budget_amount, actual_amount')
          .in('month', months),
        supabase
          .from('budgets')
          .select('actual_amount')
          .eq('user_id', user.id)
          .eq('month', curMonthStart),
        supabase
          .from('transactions')
          .select('date, description, amount, category_id')
          .eq('user_id', user.id)
          .eq('month', curMonthStart)
          .order('date', { ascending: false })
          .limit(120),
      ]);

      if (budgetError) {
        console.error('Error loading budgets:', budgetError);
      }

      const incomeMap: Record<string, number> = {};
      (incomes || []).forEach(inc => {
        const m = inc.month;
        incomeMap[m] = (incomeMap[m] || 0) + parseFloat(inc.amount || 0);
      });

      // Ensure every month has at least 0 in the incomeMap (no undefined / NaN)
      // NOTE: carry-over balances are intentionally NOT added here — they would
      // cause the same money to be counted multiple times in the yearly totals.
      for (let i = 0; i < months.length; i++) {
        const month = months[i];
        if (incomeMap[month] === undefined) incomeMap[month] = 0;
      }

      const catMonthlyMap: Record<string, { name: string; monthlyAmount: number; sortOrder: number; type: 'fixed' | 'variable' }> = {};
      (allCategories || []).forEach((c, i) => {
        catMonthlyMap[c.id] = {
          name: c.name,
          monthlyAmount: parseFloat(c.monthly_amount || 0),
          sortOrder: c.sort_order ?? i,
          type: c.type === 'fixed' ? 'fixed' : 'variable',
        };
      });

      const budgetMap: Record<string, number> = {};
      const actualMap: Record<string, number> = {};
      const catMap: Record<string, CategoryData> = {};
      categoryMonthlyActuals = {};
      (budgets || []).forEach(b => {
        const month = b.month;
        const budgetAmount = parseFloat(b.budget_amount || 0);
        const actualAmount = parseFloat(b.actual_amount || 0);
        budgetMap[month] = (budgetMap[month] || 0) + budgetAmount;
        actualMap[month] = (actualMap[month] || 0) + actualAmount;

        // Accumulate per-category actual totals
        const catId = b.category_id;
        if (catId) {
          if (!catMap[catId]) {
            const catInfo = catMonthlyMap[catId] || { name: 'Unknown', monthlyAmount: 0, sortOrder: 9999, type: 'variable' as const };
            // annualBudget = monthly_amount * 12 (category default, not summed row budgets)
            catMap[catId] = { id: catId, name: catInfo.name, annualBudget: catInfo.monthlyAmount * 12, annualActual: 0, sortOrder: catInfo.sortOrder, type: catInfo.type };
          }
          catMap[catId].annualActual += actualAmount;

          // Accumulate per-category per-month actuals for sparklines
          if (!categoryMonthlyActuals[catId]) categoryMonthlyActuals[catId] = {};
          categoryMonthlyActuals[catId][month] = (categoryMonthlyActuals[catId][month] || 0) + actualAmount;
        }
      });

      // Also include categories that have a monthly_amount but no budget rows yet this FY
      Object.entries(catMonthlyMap).forEach(([catId, catInfo]) => {
        if (!catMap[catId] && catInfo.monthlyAmount > 0) {
          catMap[catId] = { id: catId, name: catInfo.name, annualBudget: catInfo.monthlyAmount * 12, annualActual: 0, sortOrder: catInfo.sortOrder, type: catInfo.type };
        }
      });

      categoryData = Object.values(catMap).sort((a, b) => (a.sortOrder ?? 9999) - (b.sortOrder ?? 9999));

      // Build monthly data with explicit order (April=0, May=1, ..., March=11)
      // Reset monthlyData to ensure we only have current financial year months
      monthlyData = [];
      months.forEach((month, index) => {
        const monthDate = new Date(month);
        const monthName = monthDate.toLocaleString('default', { month: 'long', year: 'numeric' });
        const income = incomeMap[month] || 0;
        const budget = budgetMap[month] || 0;
        const actual = actualMap[month] || 0;
        const net = income - actual;

        monthlyData.push({
          month,
          monthName,
          income,
          budget,
          actual,
          net,
          order: index // Preserve financial year order: April=0, May=1, ..., March=11
        });
      });

      // Calculate year totals
      yearIncome = monthlyData.reduce((sum, m) => sum + m.income, 0);
      yearBudget = Object.values(catMonthlyMap).reduce((sum, c) => sum + c.monthlyAmount, 0) * 12;
      yearActual = monthlyData.reduce((sum, m) => sum + m.actual, 0);
      yearNet = yearIncome - yearActual;

      // How many FY months have at least started (drives expected-spend & burn-rate)
      monthsElapsed = getMonthsElapsed(currentYear);

      const monthlyBudgetTotal = Object.values(catMonthlyMap).reduce((sum, c) => sum + c.monthlyAmount, 0);
      const monthlySpent = (monthBudgetRows || []).reduce((sum, r) => sum + parseFloat(String(r.actual_amount || 0)), 0);
      const monthLabel = calNow.toLocaleString('default', { month: 'long', year: 'numeric' });
      updateMonthlyDashboard(
        monthlyBudgetTotal,
        monthlySpent,
        monthTxRows || [],
        monthLabel,
      );
      updateYearlyDashboard();
      buildInsightsPanel();

      // Build category breakdown
      buildCategoryBreakdown();
      
      // Update conversions
      updateYearConversions();
      await updateExchangeRate();
    } catch (error) {
      console.error('Error loading year:', error);
    }
  }

  function buildCategoryBreakdown() {
    const container = document.getElementById('categoriesContainer');
    if (!container) return;

    container.innerHTML = '';

    if (categoryData.length === 0) {
      container.innerHTML = `<div class="envelope-empty">No category data for this financial year.</div>`;
      return;
    }

    categoryData.forEach(cat => {
      const remaining = cat.annualBudget - cat.annualActual;
      const spentRatio = cat.annualBudget > 0 ? cat.annualActual / cat.annualBudget : 0;
      const overBudget = cat.annualActual > cat.annualBudget;
      const pctForBar = cat.annualBudget > 0
        ? Math.min((cat.annualActual / cat.annualBudget) * 100, 100)
        : 0;

      let barClass = 'envelope-bar--ok';
      let borderTone = 'envelope-card--accent-ok';
      if (overBudget) {
        barClass = 'envelope-bar--over';
        borderTone = 'envelope-card--accent-over';
      } else if (spentRatio > 0.8) {
        barClass = 'envelope-bar--warn';
        borderTone = 'envelope-card--accent-warn';
      }

      const leftLabel = remaining < 0 ? `${formatCurrency(Math.abs(remaining), userCurrency)} over` : formatCurrency(remaining, userCurrency);
      const leftClass = remaining < 0 ? 'envelope-amt envelope-amt--danger' : 'envelope-amt envelope-amt--positive';

      const card = document.createElement('div');
      card.className = `envelope-card ${borderTone}`;
      card.dataset.catId = cat.id;

      card.innerHTML = `
        <div class="envelope-card-inner">
          <div class="envelope-card-head">
            <h3 class="envelope-title">${escapeHtmlIndex(cat.name)}</h3>
            <button type="button" class="envelope-detail-btn" onclick="openCatModal('${cat.id}')">Detail</button>
          </div>
          <div class="envelope-rows">
            <div class="envelope-row">
              <span class="envelope-row-label">Budget</span>
              <span class="envelope-amt">${escapeHtmlIndex(formatCurrency(cat.annualBudget, userCurrency))}</span>
            </div>
            <div class="envelope-row">
              <span class="envelope-row-label">Spent</span>
              <span class="envelope-amt">${escapeHtmlIndex(formatCurrency(cat.annualActual, userCurrency))}</span>
            </div>
            <div class="envelope-row">
              <span class="envelope-row-label">Left</span>
              <span class="${leftClass}">${escapeHtmlIndex(leftLabel)}</span>
            </div>
          </div>
          <div class="envelope-track">
            <div class="envelope-bar ${barClass}" style="width: ${cat.annualBudget > 0 ? (overBudget ? '100' : String(pctForBar)) : '0'}%;"></div>
          </div>
        </div>
      `;

      container.appendChild(card);
    });
  }

  async function updateExchangeRate() {
    if (!showCurrencyConversion) {
      return;
    }
    
    try {
      // Using exchangerate-api.com free tier (no API key needed for basic usage)
      // Fetching exchange rate from user's currency to conversion currency
      const response = await fetch(`https://api.exchangerate-api.com/v4/latest/${userCurrency}`);
      const data = await response.json();
      
      if (data && data.rates && data.rates[conversionCurrency]) {
        exchangeRate = parseFloat(data.rates[conversionCurrency]);
        const rateEl = document.getElementById('exchangeRate');
        const conversionSym = getCurrencySymbol(conversionCurrency);
        if (rateEl) {
          rateEl.textContent = `1 ${userCurrency} = ${conversionSym}${exchangeRate.toFixed(4)}`;
          rateEl.style.color = 'var(--accent)';
        }
        updateYearConversions();
      } else {
        throw new Error('Exchange rate data not available');
      }
    } catch (error) {
      console.error('Error fetching exchange rate:', error);
      const rateEl = document.getElementById('exchangeRate');
      if (rateEl) {
        rateEl.textContent = 'Error loading rate';
        rateEl.style.color = 'var(--red)';
      }
      // Fallback to a default rate
      exchangeRate = 0.042;
      updateYearConversions();
    }
  }

  function updateYearConversions() {
    if (!showCurrencyConversion) {
      return;
    }
    
    const conversionSym = getCurrencySymbol(conversionCurrency);
    
    // Budget conversion
    const yearBudgetZarEl = document.getElementById('yearBudgetZar');
    const yearBudgetGbpEl = document.getElementById('yearBudgetGbp');
    if (yearBudgetZarEl) {
      yearBudgetZarEl.textContent = formatCurrency(yearBudget, userCurrency);
    }
    if (yearBudgetGbpEl && exchangeRate > 0) {
      const converted = yearBudget * exchangeRate;
      yearBudgetGbpEl.textContent = `${conversionSym}${converted.toFixed(2)}`;
    }
    
    // Actual conversion
    const yearActualZarEl = document.getElementById('yearActualZar');
    const yearActualGbpEl = document.getElementById('yearActualGbp');
    if (yearActualZarEl) {
      yearActualZarEl.textContent = formatCurrency(yearActual, userCurrency);
    }
    if (yearActualGbpEl && exchangeRate > 0) {
      const converted = yearActual * exchangeRate;
      yearActualGbpEl.textContent = `${conversionSym}${converted.toFixed(2)}`;
    }
    
    // Net conversion
    const yearNetZarEl = document.getElementById('yearNetZar');
    const yearNetGbpEl = document.getElementById('yearNetGbp');
    if (yearNetZarEl) {
      yearNetZarEl.textContent = formatCurrency(yearNet, userCurrency);
    }
    if (yearNetGbpEl && exchangeRate > 0) {
      const converted = yearNet * exchangeRate;
      yearNetGbpEl.textContent = `${conversionSym}${converted.toFixed(2)}`;
      yearNetGbpEl.style.color = yearNet >= 0 ? 'var(--accent)' : 'var(--red)';
    }
  }

  // Financial year month labels in order: Apr → Mar
  const FY_MONTH_LABELS = ['Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar'];
  const FY_MONTH_NAMES  = ['April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December', 'January', 'February', 'March'];

  function openCatModal(categoryId: string) {
    const cat = categoryData.find(c => c.id === categoryId);
    if (!cat) return;

    const monthlyAmount = cat.annualBudget / 12;
    const actuals = categoryMonthlyActuals[categoryId] || {};

    // monthlyData is already ordered Apr→Mar
    const fyMonthKeys = monthlyData.map(m => m.month);

    // Build table rows
    const rowsHtml = fyMonthKeys.map((mk, i) => {
      const actual = actuals[mk] || 0;
      const variance = actual - monthlyAmount; // positive = over budget
      const varianceColor = variance > 0 ? 'var(--red)' : 'var(--accent)';
      return `
        <tr style="border-bottom:1px solid var(--border);">
          <td style="padding:8px 4px; font-family:'DM Mono',monospace; font-size:12px; color:var(--text-dim);">${FY_MONTH_NAMES[i]}</td>
          <td style="padding:8px 4px; font-family:'DM Mono',monospace; font-size:12px; color:var(--text); text-align:right;">${formatCurrency(monthlyAmount, userCurrency)}</td>
          <td style="padding:8px 4px; font-family:'DM Mono',monospace; font-size:12px; color:var(--text); text-align:right;">${formatCurrency(actual, userCurrency)}</td>
          <td style="padding:8px 4px; font-family:'DM Mono',monospace; font-size:12px; color:${varianceColor}; text-align:right;">${formatCurrency(Math.abs(variance), userCurrency)}</td>
        </tr>`;
    }).join('');

    const tableEl = document.getElementById('catModalTable');
    if (tableEl) {
      tableEl.innerHTML = `
        <thead>
          <tr style="border-bottom:1px solid var(--border);">
            <th style="padding:6px 4px; font-family:'DM Mono',monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); text-align:left; font-weight:400;">Month</th>
            <th style="padding:6px 4px; font-family:'DM Mono',monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); text-align:right; font-weight:400;">Budget</th>
            <th style="padding:6px 4px; font-family:'DM Mono',monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); text-align:right; font-weight:400;">Actual</th>
            <th style="padding:6px 4px; font-family:'DM Mono',monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); text-align:right; font-weight:400;">Variance</th>
          </tr>
        </thead>
        <tbody>${rowsHtml}</tbody>`;
    }

    // Totals
    const totalBudget  = cat.annualBudget;
    const totalActual  = cat.annualActual;
    const totalRemaining = totalBudget - totalActual;
    const remainColor  = totalRemaining < 0 ? 'var(--red)' : 'var(--accent)';

    const totalsEl = document.getElementById('catModalTotals');
    if (totalsEl) {
      totalsEl.innerHTML = `
        <div>
          <div style="font-family:'DM Mono',monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); margin-bottom:6px;">Annual Budget</div>
          <div style="font-family:'DM Mono',monospace; font-size:16px; font-weight:500; color:var(--text);">${formatCurrency(totalBudget, userCurrency)}</div>
        </div>
        <div>
          <div style="font-family:'DM Mono',monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); margin-bottom:6px;">Total Spent</div>
          <div style="font-family:'DM Mono',monospace; font-size:16px; font-weight:500; color:var(--text);">${formatCurrency(totalActual, userCurrency)}</div>
        </div>
        <div>
          <div style="font-family:'DM Mono',monospace; font-size:10px; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); margin-bottom:6px;">Remaining</div>
          <div style="font-family:'DM Mono',monospace; font-size:16px; font-weight:500; color:${remainColor};">${formatCurrency(Math.abs(totalRemaining), userCurrency)}</div>
        </div>`;
    }

    const nameEl = document.getElementById('catModalName');
    if (nameEl) nameEl.textContent = cat.name;

    const modal = document.getElementById('catModal');
    if (modal) modal.style.display = 'block';
  }

  function closeCatModal(event?: MouseEvent) {
    const modal = document.getElementById('catModal');
    if (!modal) return;
    if (event && event.target !== modal) return;
    modal.style.display = 'none';
  }

  // Make functions available globally
  window.loadYear = loadYear;
  window.updateExchangeRate = updateExchangeRate;
  window.handleSignOut = handleSignOut;
  window.changeFY = changeFY;
  window.toggleTheme = toggleTheme;
  window.openCatModal = openCatModal;
  window.closeCatModal = closeCatModal;

  // Close modal on Escape key
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      const modal = document.getElementById('catModal');
      if (modal && modal.style.display !== 'none') {
        closeCatModal();
      }
    }
  });

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

