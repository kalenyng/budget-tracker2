---
// Settings page
import DesktopLayout from '../layouts/DesktopLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import AppCard from '../components/AppCard.astro';
import { supabase } from '../lib/supabase';

export const prerender = false;

const pathname = Astro.url.pathname;
---

<DesktopLayout title="Settings - Budget Tracker" pathname={pathname}>
<div class="page">

  <PageTitle
    label="Personal finance tracker"
    titleBefore="Settings"
    subtitle="Manage your preferences and categories"
  />

  <!-- Currency Settings -->
  <AppCard>
    <div class="label">Currency Settings</div>
    <div class="nested-panel" style="margin-top: var(--space-5);">
      <div style="margin-bottom: 24px;">
        <label style="color: var(--text-dim); font-size: 10px; display: block; margin-bottom: 8px;">Preferred Currency</label>
        <select id="preferredCurrency" class="balance-input" style="width: 100%; max-width: 300px;">
          <option value="ZAR">ZAR – South African Rand</option>
          <option value="USD">USD – US Dollar</option>
          <option value="GBP">GBP – British Pound</option>
          <option value="EUR">EUR – Euro</option>
        </select>
        <div style="color: var(--text-dim); font-size: 10px; margin-top: 4px;">This currency will be used throughout the app</div>
      </div>
      
      <div style="margin-bottom: 24px;">
        <label style="color: var(--text-dim); font-size: 10px; display: block; margin-bottom: 8px;">
          <input type="checkbox" id="showConversion">
          Show Currency Conversion
        </label>
        <div id="conversionSettings" style="margin-top: 12px; margin-left: 24px; opacity: 0.5;">
          <label style="color: var(--text-dim); font-size: 10px; display: block; margin-bottom: 8px;">Convert to</label>
          <select id="conversionCurrency" class="balance-input" style="width: 100%; max-width: 300px;">
            <option value="GBP">GBP (British Pound)</option>
            <option value="USD">USD (US Dollar)</option>
            <option value="EUR">EUR (Euro)</option>
            <option value="ZAR">ZAR (South African Rand)</option>
          </select>
        </div>
      </div>
      
      <button class="currency-btn" onclick="saveCurrencySettings()" style="margin-top: 8px;">Save Currency Settings</button>
    </div>
  </AppCard>

  <!-- Theme -->
  <AppCard>
    <div class="label">Theme</div>
    <div class="nested-panel" style="margin-top: var(--space-5);">
      <button class="currency-btn" onclick="toggleTheme()" id="themeToggle" style="width: auto; min-width: 200px;">☀ Light</button>
    </div>
  </AppCard>

  <!-- Category Management -->
  <AppCard>
    <div class="label">Category Management</div>
    <div class="nested-panel" style="margin-top: var(--space-5);">
      <button class="currency-btn" onclick="addNewCategory()" style="margin-bottom: 16px; width: auto; min-width: 200px;">+ Add Category</button>
      
      <div id="categoriesList" style="display: flex; flex-direction: column; gap: 12px;">
        <!-- Categories will be loaded here -->
      </div>
    </div>
  </AppCard>

  <footer>
    Budget Tracker · Settings
  </footer>

</div>

<button class="theme-toggle" onclick="toggleTheme()" id="themeToggleFooter">☀ Light</button>

<script>
  import { supabase } from '../lib/supabase';
  import { getCurrentUser, onAuthStateChange, signOut } from '../lib/auth';
  import { showToast, showConfirm, showPrompt } from '../lib/dialogs';
  import type { User } from '@supabase/supabase-js';

  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    const btn = document.getElementById('themeToggle');
    const btnFooter = document.getElementById('themeToggleFooter');
    if (btn) btn.textContent = theme === 'light' ? '☾ Dark' : '☀ Light';
    if (btnFooter) btnFooter.textContent = theme === 'light' ? '☾ Dark' : '☀ Light';
  }

  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'light' ? 'dark' : 'light';
    localStorage.setItem('theme', next);
    applyTheme(next);
  }

  // Apply saved theme immediately on load
  const savedTheme = localStorage.getItem('theme') || 'dark';
  applyTheme(savedTheme);

  let categories = [];
  let userCurrency = 'ZAR';

  // Check authentication on page load
  async function checkAuth() {
    const user = await getCurrentUser();
    if (!user) {
      window.location.href = '/auth';
      return false;
    }
    updateCurrentUserEmail(user);
    return true;
  }

  function updateCurrentUserEmail(user: User | null) {
    const emailEl = document.getElementById('currentUserEmail');
    if (!emailEl) return;
    emailEl.textContent = user?.email || 'Signed in';
    emailEl.title = user?.email || 'Signed in user';
  }

  // Handle sign out
  async function handleSignOut() {
    if (await showConfirm('Sign Out', 'Are you sure you want to sign out?', 'Sign Out')) {
      await signOut();
      window.location.href = '/auth';
    }
  }

  function showSkeletons() {
    const categoriesList = document.getElementById('categoriesList');
    if (categoriesList) {
      categoriesList.innerHTML = `
        <div class="skeleton skeleton-row" style="width: 100%;"></div>
        <div class="skeleton skeleton-row" style="width: 100%;"></div>
        <div class="skeleton skeleton-row" style="width: 100%;"></div>
        <div class="skeleton skeleton-row" style="width: 100%;"></div>
        <div class="skeleton skeleton-row" style="width: 100%;"></div>
      `;
    }
  }

  // Initialize
  async function init() {
    onAuthStateChange((_event, session) => {
      updateCurrentUserEmail(session?.user ?? null);
      if (!session?.user) {
        window.location.href = '/auth';
      }
    });

    showSkeletons();
    const isAuthenticated = await checkAuth();
    if (!isAuthenticated) {
      return;
    }
    
    await loadSettings();
    await loadCategories();
    setupConversionToggle();
  }

  async function loadSettings() {
    try {
      const user = await getCurrentUser();
      if (!user) return;

      const { data: settingsRows } = await supabase
        .from('user_settings')
        .select('key, value, preferred_currency')
        .eq('user_id', user.id);

      const settingsMap = Object.fromEntries((settingsRows || []).map(s => [s.key, s.value]));
      userCurrency = settingsMap['preferred_currency'] || 'ZAR';
      const showConversion = settingsMap['show_currency_conversion'] === 'true';
      const conversionCurrency = settingsMap['conversion_currency'] || 'GBP';

      // Set UI values
      const preferredCurrencySelect = document.getElementById('preferredCurrency');
      if (preferredCurrencySelect) {
        preferredCurrencySelect.value = userCurrency;
      }

      const showConversionCheckbox = document.getElementById('showConversion');
      if (showConversionCheckbox) {
        showConversionCheckbox.checked = showConversion;
      }

      const conversionCurrencySelect = document.getElementById('conversionCurrency');
      if (conversionCurrencySelect) {
        conversionCurrencySelect.value = conversionCurrency;
      }

      updateConversionSettingsVisibility();
    } catch (error) {
      console.error('Error loading settings:', error);
    }
  }
  
  function updateConversionSettingsVisibility() {
    const checkbox = document.getElementById('showConversion');
    const settingsDiv = document.getElementById('conversionSettings');
    if (checkbox && settingsDiv) {
      settingsDiv.style.opacity = checkbox.checked ? '1' : '0.5';
      settingsDiv.style.pointerEvents = checkbox.checked ? 'auto' : 'none';
    }
  }

  async function loadCategories() {
    try {
      const { data, error } = await supabase
        .from('categories')
        .select('*')
        .order('sort_order', { ascending: true, nullsFirst: false })
        .order('name', { ascending: true });
      
      if (error) throw error;
      
      categories = data || [];
      renderCategories();
    } catch (error) {
      console.error('Error loading categories:', error);
    }
  }

  function renderCategories() {
    const container = document.getElementById('categoriesList');
    if (!container) return;
    
    if (categories.length === 0) {
      container.innerHTML = '<div style="color: var(--text-dim); padding: 24px; text-align: center;">No categories found. Add your first category above.</div>';
      return;
    }
    
    container.innerHTML = '';
    
    const currencySymbol = getCurrencySymbol(userCurrency);

    categories.forEach(cat => {
      const div = document.createElement('div');
      div.className = 'category-item';
      div.setAttribute('draggable', 'true');
      div.dataset.catId = cat.id;
      
      div.innerHTML = `
        <div class="drag-handle" title="Drag to reorder">⠿</div>
        <div style="flex: 1; display: flex; flex-direction: column; gap: 8px;">
          <input type="text" 
                 value="${escapeHtml(cat.name)}" 
                 data-id="${cat.id}"
                 class="category-name-input"
                 ondragstart="event.stopPropagation()"
                 onchange="updateCategoryName('${cat.id}', this.value)"
                 placeholder="Category name">
          <div style="display: flex; gap: 12px; align-items: center; font-size: 10px; color: var(--text-dim); flex-wrap: wrap;">
            <span>Type: ${cat.type || 'variable'}</span>
            ${cat.category_group ? `<span>Group: ${escapeHtml(cat.category_group)}</span>` : ''}
          </div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 8px; width: 100%; max-width: 200px;">
          <label style="color: var(--text-dim); font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;">Monthly Budget</label>
          <div style="display: flex; align-items: center; gap: 4px;">
            <span style="color: var(--muted); font-size: 11px;">${currencySymbol}</span>
            <input type="number"
                   value="${parseFloat(cat.monthly_amount || 0)}"
                   class="category-default-input"
                   ondragstart="event.stopPropagation()"
                   onchange="updateCategoryDefault('${cat.id}', this.value)"
                   onblur="updateCategoryDefault('${cat.id}', this.value)"
                   placeholder="0"
                   style="flex: 1;">
          </div>
        </div>
        <button onclick="deleteCategory('${cat.id}')" 
                ondragstart="event.stopPropagation()"
                class="currency-btn"
                style="background: var(--red); border-color: var(--red); color: white; width: auto; min-width: 100px;">Delete</button>
      `;
      
      container.appendChild(div);
    });

    setupDragAndDrop();
  }

  let dragSrcId: string | null = null;

  function setupDragAndDrop() {
    const container = document.getElementById('categoriesList');
    if (!container) return;

    container.querySelectorAll<HTMLElement>('.category-item[draggable]').forEach(el => {
      el.addEventListener('dragstart', (e: DragEvent) => {
        dragSrcId = el.dataset.catId || null;
        el.classList.add('dragging');
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', dragSrcId || '');
        }
      });

      el.addEventListener('dragend', () => {
        el.classList.remove('dragging');
        container.querySelectorAll('.drag-over').forEach(o => o.classList.remove('drag-over'));
      });

      el.addEventListener('dragover', (e: DragEvent) => {
        e.preventDefault();
        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
        container.querySelectorAll('.drag-over').forEach(o => { if (o !== el) o.classList.remove('drag-over'); });
        el.classList.add('drag-over');
      });

      el.addEventListener('dragleave', (e: DragEvent) => {
        if (!el.contains(e.relatedTarget as Node)) el.classList.remove('drag-over');
      });

      el.addEventListener('drop', async (e: DragEvent) => {
        e.preventDefault();
        el.classList.remove('drag-over');
        const dropId = el.dataset.catId;
        if (!dragSrcId || !dropId || dragSrcId === dropId) return;

        const srcIndex = categories.findIndex((c: any) => c.id === dragSrcId);
        const dstIndex = categories.findIndex((c: any) => c.id === dropId);
        if (srcIndex === -1 || dstIndex === -1) return;

        const [moved] = categories.splice(srcIndex, 1);
        categories.splice(dstIndex, 0, moved);

        renderCategories();
        await saveSortOrder();
      });
    });
  }

  async function saveSortOrder() {
    try {
      await Promise.all(
        categories.map((cat: any, index: number) =>
          supabase.from('categories').update({ sort_order: index }).eq('id', cat.id)
        )
      );
    } catch (error) {
      console.error('Error saving sort order:', error);
      showToast('Error saving order', 'error');
    }
  }

  async function saveCurrencySettings() {
    try {
      const user = await getCurrentUser();
      if (!user) {
        showToast('You must be logged in to save settings', 'error');
        return;
      }
      
      const preferredCurrency = (document.getElementById('preferredCurrency') as HTMLSelectElement).value;
      const showConversion = (document.getElementById('showConversion') as HTMLInputElement).checked;
      const conversionCurrency = (document.getElementById('conversionCurrency') as HTMLSelectElement).value;
      
      // Update preferred_currency
      await supabase
        .from('user_settings')
        .upsert({
          user_id: user.id,
          key: 'preferred_currency',
          value: preferredCurrency,
          preferred_currency: preferredCurrency
        }, {
          onConflict: 'user_id,key'
        });
      
      // Update show_currency_conversion
      await supabase
        .from('user_settings')
        .upsert({
          user_id: user.id,
          key: 'show_currency_conversion',
          value: showConversion.toString()
        }, {
          onConflict: 'user_id,key'
        });
      
      // Update conversion_currency
      await supabase
        .from('user_settings')
        .upsert({
          user_id: user.id,
          key: 'conversion_currency',
          value: conversionCurrency
        }, {
          onConflict: 'user_id,key'
        });
      
      showToast('Currency settings saved');
      // Reload page to apply currency changes
      window.location.reload();
    } catch (error: any) {
      console.error('Error saving currency settings:', error);
      showToast('Error saving currency settings: ' + error.message, 'error');
    }
  }

  async function updateCategoryName(categoryId: string, newName: string) {
    if (!newName || newName.trim() === '') {
      showToast('Category name cannot be empty', 'error');
      await loadCategories(); // Reload to reset
      return;
    }
    
    try {
      const { error } = await supabase
        .from('categories')
        .update({ name: newName.trim() })
        .eq('id', categoryId);
      
      if (error) throw error;
      
      // Update local array
      const index = categories.findIndex((c: any) => c.id === categoryId);
      if (index !== -1) {
        categories[index].name = newName.trim();
      }
    } catch (error: any) {
      console.error('Error updating category name:', error);
      showToast('Error updating category: ' + error.message, 'error');
      await loadCategories(); // Reload on error
    }
  }

  async function updateCategoryDefault(categoryId: string, value: string) {
    const amount = parseFloat(value) || 0;
    try {
      const { error } = await supabase
        .from('categories')
        .update({ monthly_amount: amount })
        .eq('id', categoryId);
      
      if (error) throw error;
      
      // Update local array
      const index = categories.findIndex((c: any) => c.id === categoryId);
      if (index !== -1) {
        categories[index].monthly_amount = amount;
      }
    } catch (error: any) {
      console.error('Error updating category default:', error);
      showToast('Error updating default budget: ' + error.message, 'error');
      await loadCategories(); // Reload on error
    }
  }

  async function addNewCategory() {
    const user = await getCurrentUser();
    if (!user) {
      showToast('You must be logged in to add categories', 'error');
      return;
    }

    const name = await showPrompt('Add Category', 'e.g. Groceries', 'Add');
    if (!name) return;

    const isFixed = await showConfirm('Category Type', 'Is this a fixed monthly expense?', 'Yes, fixed');
    const type = isFixed ? 'fixed' : 'variable';

    try {
      const { data, error } = await supabase
        .from('categories')
        .insert({
          name: name,
          type: type,
          monthly_amount: 0,
          user_id: user.id,
          sort_order: categories.length
        })
        .select()
        .single();

      if (error) throw error;

      categories.push(data);
      renderCategories();
      showToast(`Category "${name}" added`);
    } catch (error: any) {
      console.error('Error adding category:', error);
      showToast('Error adding category: ' + error.message, 'error');
    }
  }

  async function deleteCategory(categoryId: string) {
    const category = categories.find((c: any) => c.id === categoryId);
    if (!category) return;
    
    if (!await showConfirm('Delete Category', `Delete "${category.name}"? This will also delete all associated budgets.`, 'Delete', true)) {
      return;
    }
    
    try {
      const { error } = await supabase
        .from('categories')
        .delete()
        .eq('id', categoryId);
      
      if (error) throw error;
      
      await loadCategories();
    } catch (error: any) {
      console.error('Error deleting category:', error);
      showToast('Error deleting category: ' + error.message, 'error');
    }
  }

  function getCurrencySymbol(currency: string) {
    const symbols: Record<string, string> = {
      'ZAR': 'R',
      'GBP': '£',
      'USD': '$',
      'EUR': '€'
    };
    return symbols[currency] || currency;
  }

  function escapeHtml(text: string) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Make functions available globally
  function setupConversionToggle() {
    const checkbox = document.getElementById('showConversion');
    if (checkbox) {
      checkbox.addEventListener('change', updateConversionSettingsVisibility);
    }
  }

  (window as any).updateCategoryName = updateCategoryName;
  (window as any).updateCategoryDefault = updateCategoryDefault;
  (window as any).addNewCategory = addNewCategory;
  (window as any).deleteCategory = deleteCategory;
  (window as any).saveCurrencySettings = saveCurrencySettings;
  (window as any).handleSignOut = handleSignOut;
  (window as any).toggleTheme = toggleTheme;
  (window as any).saveSortOrder = saveSortOrder;

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style is:global>
  /* Page-specific styles for settings.astro */

  .category-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--surface-2);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-md);
    transition:
      border-color var(--transition-fast),
      background var(--transition-fast);
    cursor: default;
  }

  .category-item:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border-muted));
    background: color-mix(in srgb, var(--surface-3) 15%, var(--surface-2));
  }

  .category-item.dragging {
    opacity: 0.4;
    border-style: dashed;
  }

  .category-item.drag-over {
    border-color: var(--accent);
    background: var(--surface);
    transform: scale(1.01);
  }

  .drag-handle {
    color: var(--text-dim);
    cursor: grab;
    font-size: 18px;
    padding: 4px 2px;
    user-select: none;
    flex-shrink: 0;
    line-height: 1;
    opacity: 0.5;
    transition: opacity 0.15s;
  }

  .category-item:hover .drag-handle {
    opacity: 1;
  }

  .drag-handle:active {
    cursor: grabbing;
  }

  .category-name-input,
  .category-default-input {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    padding: 8px 10px;
    border-radius: 4px;
    width: 100%;
  }

  .category-name-input:focus,
  .category-default-input:focus {
    outline: none;
    border-color: var(--accent);
  }

  input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    width: 16px;
    height: 16px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
    position: relative;
    transition: all 0.15s;
    margin-right: 8px;
    vertical-align: middle;
  }

  input[type="checkbox"]:hover {
    border-color: var(--accent);
  }

  input[type="checkbox"]:checked {
    background: var(--accent);
    border-color: var(--accent);
  }

  input[type="checkbox"]:checked::after {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #0d0f0e;
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
  }

  input[type="checkbox"]:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(200, 245, 96, 0.2);
  }

</style>

</DesktopLayout>
