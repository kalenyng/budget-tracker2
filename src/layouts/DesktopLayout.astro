---
import PwaHead from '../components/PwaHead.astro';

interface Props {
  title: string;
  /** Current request path for active nav (pass Astro.url.pathname from the page). */
  pathname: string;
}

const { title, pathname: rawPath } = Astro.props;
const path = (rawPath.replace(/\/$/, '') || '/') as string;

function isActive(href: string): boolean {
  if (href === '/') return path === '/' || path === '';
  return path === href || path.startsWith(href + '/');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline src="/viewport-guard.js"></script>
    <PwaHead />
    <title>{title}</title>
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=IBM+Plex+Mono:wght@400;500&family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/desktop-layout.css" />
    <script is:inline>
      (function () {
        const t = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body class="desktop-with-sidebar">
    <div class="desktop-shell" id="desktopShell" data-sidebar-collapsed="true">
      <aside class="desktop-sidebar" aria-label="Main navigation">
        <div class="desktop-sidebar-inner">
          <div class="desktop-sidebar-brand">
            <span class="desktop-sidebar-brand-text">Budget</span>
            <button
              type="button"
              class="desktop-sidebar-toggle"
              id="desktopSidebarToggle"
              aria-label="Toggle sidebar"
              title="Toggle sidebar"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 6h16M4 12h16M4 18h10" />
              </svg>
            </button>
          </div>
          <nav class="desktop-nav">
            <a
              href="/"
              class:list={[{ active: isActive('/') }]}
              title="Yearly Overview"
              aria-current={isActive('/') ? 'page' : undefined}
            >
              <span class="desktop-nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /></svg>
              </span>
              <span class="desktop-nav-label">Yearly Overview</span>
            </a>
            <a
              href="/month"
              class:list={[{ active: isActive('/month') }]}
              title="Monthly Tracker"
              aria-current={isActive('/month') ? 'page' : undefined}
            >
              <span class="desktop-nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M3 10h18M8 4v16" /></svg>
              </span>
              <span class="desktop-nav-label">Monthly Tracker</span>
            </a>
            <a
              href="/insights"
              class:list={[{ active: isActive('/insights') }]}
              title="Insights"
              aria-current={isActive('/insights') ? 'page' : undefined}
            >
              <span class="desktop-nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M18 20V10M12 20V4M6 20v-6" /></svg>
              </span>
              <span class="desktop-nav-label">Insights</span>
            </a>
            <a
              href="/transactions"
              class:list={[{ active: isActive('/transactions') }]}
              title="Transactions"
              aria-current={isActive('/transactions') ? 'page' : undefined}
            >
              <span class="desktop-nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" /></svg>
              </span>
              <span class="desktop-nav-label">Transactions</span>
            </a>
            <a
              href="/settings"
              class:list={[{ active: isActive('/settings') }]}
              title="Settings"
              aria-current={isActive('/settings') ? 'page' : undefined}
            >
              <span class="desktop-nav-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path
                    d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"
                  ></path>
                </svg>
              </span>
              <span class="desktop-nav-label">Settings</span>
            </a>
          </nav>
        </div>
      </aside>
      <div class="desktop-main">
        <header class="desktop-topbar">
          <div class="desktop-topbar-start">
            <slot name="toolbar-start" />
          </div>
          <div class="desktop-topbar-end">
            <div id="currentUserEmail" class="desktop-user-email" title="Signed in user">
              Loading account...
            </div>
            <button
              type="button"
              class="btn btn-danger"
              onclick="handleSignOut()"
              title="Sign Out"
            >
              Sign Out
            </button>
          </div>
        </header>
        <div class="desktop-content">
          <slot />
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var key = 'budget_desktop_sidebar_collapsed';
        var shell = document.getElementById('desktopShell');
        var btn = document.getElementById('desktopSidebarToggle');
        function readCollapsed() {
          try {
            var v = localStorage.getItem(key);
            if (v === null) return true;
            return v === 'true';
          } catch (e) {
            return true;
          }
        }
        function apply() {
          if (!shell) return;
          var mq = window.matchMedia('(max-width: 900px)');
          var stored = readCollapsed();
          var collapsed = mq.matches ? true : stored;
          shell.setAttribute('data-sidebar-collapsed', collapsed ? 'true' : 'false');
        }
        function toggle() {
          if (!shell) return;
          var mq = window.matchMedia('(max-width: 900px)');
          if (mq.matches) return;
          var cur = readCollapsed();
          try {
            localStorage.setItem(key, (!cur).toString());
          } catch (e) {}
          apply();
        }
        apply();
        btn &&
          btn.addEventListener('click', function (e) {
            e.stopPropagation();
            toggle();
          });
        window.addEventListener('resize', function () {
          apply();
        });
        document.addEventListener('click', function (e) {
          if (!shell) return;
          if (window.matchMedia('(max-width: 900px)').matches) return;
          if (shell.getAttribute('data-sidebar-collapsed') === 'true') return;
          var tgt = e.target;
          var fromEl =
            tgt instanceof Element ? tgt : tgt && tgt.parentElement ? tgt.parentElement : null;
          if (fromEl && fromEl.closest && fromEl.closest('.desktop-sidebar')) return;
          try {
            localStorage.setItem(key, 'true');
          } catch (err) {}
          apply();
        });
      })();
    </script>
  </body>
</html>
